# Maintainer: chiiydd <noreply@example.com>
pkgname=wisp-git
_pkgname=wisp
pkgver=0.1.0.r0.g0000000
pkgrel=1
pkgdesc="Modern disk cleanup and analysis tool for Arch Linux (VCS, master)"
arch=('x86_64' 'aarch64')
url="https://github.com/chiiydd/wisp"
license=('MIT' 'Apache')
depends=('gcc-libs')
makedepends=('cargo' 'git')
optdepends=(
    'pacman-contrib: paccache cleaner'
    'systemd: journal cleaner'
    'flatpak: flatpak cleaner'
    'docker: docker cleaner'
)
provides=("$_pkgname=$pkgver")
conflicts=("$_pkgname")
source=("$_pkgname::git+$url.git")
sha256sums=('SKIP')

pkgver() {
    cd "$_pkgname"
    # Format: <last-tag>.r<commits-since>.g<short-sha>; falls back if no tag.
    git describe --long --tags --abbrev=7 2>/dev/null \
        | sed 's/^v//;s/\([^-]*-g\)/r\1/;s/-/./g' \
        || printf "0.1.0.r%s.g%s" "$(git rev-list --count HEAD)" "$(git rev-parse --short=7 HEAD)"
}

prepare() {
    cd "$_pkgname"
    export RUSTUP_TOOLCHAIN=stable
    cargo fetch --locked --target "$(rustc -vV | sed -n 's/host: //p')"
}

build() {
    cd "$_pkgname"
    export RUSTUP_TOOLCHAIN=stable
    export CARGO_TARGET_DIR=target
    cargo build --frozen --release --package wisp-cli
}

check() {
    cd "$_pkgname"
    export RUSTUP_TOOLCHAIN=stable
    cargo test --frozen --release --workspace
}

package() {
    cd "$_pkgname"

    install -Dm755 "target/release/wisp" "$pkgdir/usr/bin/wisp"

    install -dm755 "$pkgdir/usr/share/bash-completion/completions"
    install -dm755 "$pkgdir/usr/share/zsh/site-functions"
    install -dm755 "$pkgdir/usr/share/fish/vendor_completions.d"
    install -dm755 "$pkgdir/usr/share/man/man1"

    "$pkgdir/usr/bin/wisp" completion bash > "$pkgdir/usr/share/bash-completion/completions/wisp"
    "$pkgdir/usr/bin/wisp" completion zsh  > "$pkgdir/usr/share/zsh/site-functions/_wisp"
    "$pkgdir/usr/bin/wisp" completion fish > "$pkgdir/usr/share/fish/vendor_completions.d/wisp.fish"
    "$pkgdir/usr/bin/wisp" man             > "$pkgdir/usr/share/man/man1/wisp.1"

    install -Dm644 README.md       "$pkgdir/usr/share/doc/$_pkgname/README.md"
    install -Dm644 CONTRIBUTING.md  "$pkgdir/usr/share/doc/$_pkgname/CONTRIBUTING.md"
}
